# Focus Plan M3E environment variables.
# Firebase web config values are PUBLIC (they identify the project, they are
# not secrets). Copy this file to .env.local and fill in the values from the
# Firebase console (Project settings > Your apps > Web app config).
# See docs/HANDOFF.md "Firebase setup" for the exact console steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect Auth and Firestore to the local Emulator Suite
# instead of the real project. Requires: npm run firebase:emulators
# (needs Java 11+ and firebase-tools; see docs/HANDOFF.md).
VITE_USE_EMULATORS=false

# GEMINI_API_KEY: Server-side API key for Gemini features (intake consult,
# study plan generator, and post-test analysis). Injected automatically in
# AI Studio environment. Never exposed in the client browser bundle.
GEMINI_API_KEY=

# VITE_AI_API_URL: Optional base URL of the AI proxy server. Empty means
# same origin (works when the app is served by `npm run dev:server` or a
# deployment that hosts server.ts). Example: http://localhost:3100
VITE_AI_API_URL=

# Server-side only (used by server.ts, never shipped to the browser):
# FIREBASE_PROJECT_ID: project id used to verify Firebase ID tokens.
# AI_DAILY_LIMIT: max Gemini calls per signed-in user per day (default 30).
# AI_ALLOWED_ORIGINS: comma-separated CORS origins for cross-origin calls.
# FIREBASE_AUTH_EMULATOR_HOST: set automatically when using the Auth
# emulator; allows unsigned emulator ID tokens for local dev only.
FIREBASE_PROJECT_ID=
AI_DAILY_LIMIT=
AI_ALLOWED_ORIGINS=

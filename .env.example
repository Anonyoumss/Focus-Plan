# Focus Plan M3E environment variables.
# Firebase web config values are PUBLIC (they identify the project, they are
# not secrets). Copy this file to .env.local and fill in the values from the
# Firebase console (Project settings > Your apps > Web app config).
# See docs/HANDOFF.md "Firebase setup" for the exact console steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect Auth and Firestore to the local Emulator Suite
# instead of the real project. Requires: npm run firebase:emulators
# (needs Java 11+ and firebase-tools; see docs/HANDOFF.md).
VITE_USE_EMULATORS=false
